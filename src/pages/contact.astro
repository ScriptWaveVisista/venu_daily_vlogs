---
import { siteConfig } from "../config/site";
import ContentLayout from "../layouts/ContentLayout.astro";
import { pageTitle } from "../utils/seo";
import { isConfiguredEmail, isConfiguredUrl } from "../utils/urls";

const emailReady = isConfiguredEmail(siteConfig.email);
const youtubeReady = isConfiguredUrl(siteConfig.youtube);
const instagramReady = isConfiguredUrl(siteConfig.instagram);
const whatsappReady = isConfiguredUrl(siteConfig.whatsapp);
const facebookReady = isConfiguredUrl(siteConfig.facebook);
---

<ContentLayout
  title={pageTitle("Contact")}
  description={`Contact ${siteConfig.name} for collaborations, recipes and YouTube enquiries.`}
  canonicalPath="/contact/"
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">Hello</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Contact</h1>
    <p class="mt-4 text-lg text-muted">
      This is a static website, so there is no contact form. Use the links below for
      collaborations and messages.
    </p>
  </header>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">Business collaborations</h2>
      <p class="mt-3 text-muted">
        For brand, recipe or video collaborations, write through email or a social
        channel once those links are added in <code>src/config/site.ts</code>.
      </p>
    </section>

    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">Email</h2>
      {
        emailReady ? (
          <a href={`mailto:${siteConfig.email}`} class="mt-3 inline-block font-medium text-accent-deep hover:underline">
            {siteConfig.email}
          </a>
        ) : (
          <p class="mt-3 text-muted">
            Add <code>email</code> in <code>src/config/site.ts</code>.
          </p>
        )
      }
    </section>

    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">YouTube</h2>
      {
        youtubeReady ? (
          <a
            href={siteConfig.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            Visit the channel <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <p class="mt-3 text-muted">Add your YouTube URL in site configuration.</p>
        )
      }
    </section>

    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">Instagram</h2>
      {
        instagramReady ? (
          <a
            href={siteConfig.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            Instagram <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <p class="mt-3 text-muted">Add your Instagram URL in site configuration.</p>
        )
      }
    </section>

    {
      whatsappReady && (
        <section class="rounded-3xl bg-white p-6">
          <h2 class="font-serif text-2xl">WhatsApp</h2>
          <a
            href={siteConfig.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            Message on WhatsApp <span aria-hidden="true">↗</span>
          </a>
        </section>
      )
    }

    {
      facebookReady && (
        <section class="rounded-3xl bg-white p-6">
          <h2 class="font-serif text-2xl">Facebook</h2>
          <a
            href={siteConfig.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            Facebook <span aria-hidden="true">↗</span>
          </a>
        </section>
      )
    }
  </div>
</ContentLayout>
