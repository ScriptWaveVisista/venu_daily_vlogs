---
import EmptyState from "../../components/EmptyState.astro";
import VlogCard from "../../components/VlogCard.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { getPublishedVlogs, getVlogCategories } from "../../utils/content";
import { pageTitle } from "../../utils/seo";
import { toSlug } from "../../utils/slug";
import { withBase } from "../../utils/urls";

const vlogs = await getPublishedVlogs();
const categories = getVlogCategories(vlogs);
---

<ContentLayout
  title={pageTitle("Vlogs")}
  description="Family, lifestyle, travel and everyday Telugu vlogs from Venu Daily Vlogs."
  canonicalPath="/vlogs/"
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">Stories</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Vlogs</h1>
    <p class="mt-4 text-lg text-muted">
      Everyday family moments, food, travel and lifestyle videos.
    </p>
  </header>

  {
    categories.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-2">
        {categories.map((category) => (
          <a
            href={withBase(`/vlogs/category/${toSlug(category)}/`)}
            class="rounded-full border border-line bg-white px-4 py-2 text-sm font-medium hover:border-accent"
          >
            {category}
          </a>
        ))}
      </div>
    )
  }

  {
    vlogs.length > 0 ? (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {vlogs.map((vlog) => (
          <VlogCard vlog={vlog} />
        ))}
      </div>
    ) : (
      <div class="mt-10">
        <EmptyState
          title="No vlogs published yet"
          message="Family, travel and lifestyle videos will appear here."
        />
      </div>
    )
  }
</ContentLayout>
