---
import { siteConfig } from "../config/site";
import ContentLayout from "../layouts/ContentLayout.astro";
import { publicAssetExists } from "../utils/images";
import { pageTitle } from "../utils/seo";
import { isConfiguredUrl } from "../utils/urls";

const hasProfile = publicAssetExists(siteConfig.profileImage);
---

<ContentLayout
  title={pageTitle("About")}
  description={`About ${siteConfig.name}: cooking, family moments, lifestyle and Telugu vlogs.`}
  canonicalPath="/about/"
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">About</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">About {siteConfig.name}</h1>
  </header>

  <div class="mt-10 grid gap-10 lg:grid-cols-[280px_1fr]">
    <div>
      {
        hasProfile ? (
          <img
            src={siteConfig.profileImage}
            alt={`${siteConfig.author} of ${siteConfig.name}`}
            width="560"
            height="700"
            class="w-full rounded-[2rem] object-cover"
          />
        ) : (
          <div class="flex aspect-[4/5] items-end rounded-[2rem] bg-cream-deep p-8">
            <div>
              <p class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-2xl font-bold text-white">
                V
              </p>
              <p class="mt-4 text-sm text-muted">
                Add a photo at <code>public/images/profile/venu.jpg</code>
              </p>
            </div>
          </div>
        )
      }
    </div>

    <div class="max-w-2xl space-y-6 text-lg leading-relaxed">
      <p>
        {siteConfig.name} is a YouTube and lifestyle space for cooking, everyday food,
        family moments, travel and Telugu stories.
      </p>
      <p>
        The channel shares simple homemade recipes, kitchen videos, daily life and
        the small moments that make an ordinary day feel warm.
      </p>
      <div class="rounded-3xl border border-dashed border-line bg-white p-6 text-base">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-muted">
          Update this section
        </p>
        <p class="mt-3 text-muted">
          Replace this placeholder with a short personal introduction. Do not invent
          hometown, family details, subscriber counts, awards or brand partnerships
          unless they are real. Edit this page at <code>src/pages/about.astro</code>
          or keep the current general description if you prefer.
        </p>
      </div>
      <ul class="grid gap-3 text-base sm:grid-cols-2">
        <li class="rounded-2xl bg-white px-4 py-3">Cooking videos</li>
        <li class="rounded-2xl bg-white px-4 py-3">Everyday lifestyle</li>
        <li class="rounded-2xl bg-white px-4 py-3">Food and recipes</li>
        <li class="rounded-2xl bg-white px-4 py-3">Family moments</li>
        <li class="rounded-2xl bg-white px-4 py-3">Travel vlogs</li>
        <li class="rounded-2xl bg-white px-4 py-3">Telugu content</li>
      </ul>
      <div class="flex flex-wrap gap-3">
        {
          isConfiguredUrl(siteConfig.youtube) && (
            <a
              href={siteConfig.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white hover:bg-accent-deep"
            >
              YouTube <span aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          isConfiguredUrl(siteConfig.instagram) && (
            <a
              href={siteConfig.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-line bg-white px-5 py-3 text-sm font-semibold hover:border-accent"
            >
              Instagram <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</ContentLayout>
