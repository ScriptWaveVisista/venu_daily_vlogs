---
import { siteConfig } from "../../config/site";
import { isLocale, localeStaticPaths, t } from "../../i18n";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { pageTitle } from "../../utils/seo";
import { isConfiguredEmail, isConfiguredUrl, localePath } from "../../utils/urls";

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang;
if (!isLocale(lang)) throw new Error("Invalid locale");
const locale = lang;
const copy = t(locale);
const emailReady = isConfiguredEmail(siteConfig.email);
const youtubeReady = isConfiguredUrl(siteConfig.youtube);
const instagramReady = isConfiguredUrl(siteConfig.instagram);
const whatsappReady = isConfiguredUrl(siteConfig.whatsapp);
const facebookReady = isConfiguredUrl(siteConfig.facebook);
---

<ContentLayout
  title={pageTitle(copy.pages.contactTitle)}
  description={copy.pages.contactDescription}
  locale={locale}
  canonicalPath={localePath(locale, "/contact/")}
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">{copy.pages.contactEyebrow}</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">{copy.pages.contactTitle}</h1>
    <p class="mt-4 text-lg text-muted">{copy.pages.contactIntro}</p>
  </header>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">{copy.pages.collaborations}</h2>
      <p class="mt-3 text-muted">{copy.pages.collaborationsBody}</p>
    </section>

    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">{copy.pages.email}</h2>
      {
        emailReady ? (
          <a href={`mailto:${siteConfig.email}`} class="mt-3 inline-block font-medium text-accent-deep hover:underline">
            {siteConfig.email}
          </a>
        ) : (
          <p class="mt-3 text-muted">{copy.pages.addEmail}</p>
        )
      }
    </section>

    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">YouTube</h2>
      {
        youtubeReady ? (
          <a
            href={siteConfig.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            {copy.pages.visitChannel}
          </a>
        ) : (
          <p class="mt-3 text-muted">{copy.pages.addYoutube}</p>
        )
      }
    </section>

    <section class="rounded-3xl bg-white p-6">
      <h2 class="font-serif text-2xl">Instagram</h2>
      {
        instagramReady ? (
          <a
            href={siteConfig.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            Instagram
          </a>
        ) : (
          <p class="mt-3 text-muted">{copy.pages.addInstagram}</p>
        )
      }
    </section>

    {
      whatsappReady && (
        <section class="rounded-3xl bg-white p-6">
          <h2 class="font-serif text-2xl">WhatsApp</h2>
          <a
            href={siteConfig.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            WhatsApp
          </a>
        </section>
      )
    }

    {
      facebookReady && (
        <section class="rounded-3xl bg-white p-6">
          <h2 class="font-serif text-2xl">Facebook</h2>
          <a
            href={siteConfig.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-medium text-accent-deep hover:underline"
          >
            Facebook
          </a>
        </section>
      )
    }
  </div>
</ContentLayout>
