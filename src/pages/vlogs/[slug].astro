---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import SmartImage from "../../components/SmartImage.astro";
import SubscribeCTA from "../../components/SubscribeCTA.astro";
import VlogCard from "../../components/VlogCard.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { getPublishedVlogs, type VlogEntry } from "../../utils/content";
import { formatDate } from "../../utils/dates";
import { getRelatedItems } from "../../utils/related";
import { breadcrumbJsonLd, vlogJsonLd } from "../../utils/schema";
import { pageTitle } from "../../utils/seo";
import { toSlug } from "../../utils/slug";
import { render } from "astro:content";

export async function getStaticPaths() {
  const vlogs = await getPublishedVlogs();
  return vlogs.map((vlog) => ({
    params: { slug: vlog.id },
    props: { vlog },
  }));
}

interface Props {
  vlog: VlogEntry;
}

const { vlog } = Astro.props;
const vlogs = await getPublishedVlogs();
const related = getRelatedItems(vlog, vlogs, 3);
const { Content } = await render(vlog);
const categorySlug = toSlug(vlog.data.category);
const pagePath = `/vlogs/${vlog.id}/`;
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/vlogs/", label: "Vlogs" },
  { href: `/vlogs/category/${categorySlug}/`, label: vlog.data.category },
  { href: pagePath, label: vlog.data.title },
];
---

<ContentLayout
  title={pageTitle(vlog.data.title)}
  description={vlog.data.description}
  image={vlog.data.thumbnail}
  canonicalPath={pagePath}
>
  <JsonLd schema={[vlogJsonLd(vlog, pagePath), breadcrumbJsonLd(crumbs)]} />

  <article>
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-3xl">
      {vlog.data.demo && (
        <p class="mb-3 inline-flex rounded-full bg-cream-deep px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]">
          Demo sample vlog
        </p>
      )}
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">
        {vlog.data.category}
      </p>
      <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">{vlog.data.title}</h1>
      <p class="mt-4 text-lg text-muted">{vlog.data.description}</p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm text-muted">
        <time datetime={vlog.data.publishedDate.toISOString()}>
          {formatDate(vlog.data.publishedDate)}
        </time>
        {vlog.data.location && <span>{vlog.data.location}</span>}
      </div>
    </header>

    <div class="mt-8 overflow-hidden rounded-[2rem]">
      <SmartImage
        src={vlog.data.thumbnail}
        alt={vlog.data.title}
        width={1600}
        height={900}
        priority
        class="aspect-video w-full object-cover"
      />
    </div>

    {
      vlog.data.youtubeUrl && (
        <section class="no-print mt-10">
          <YouTubeEmbed youtubeUrl={vlog.data.youtubeUrl} title={vlog.data.title} />
        </section>
      )
    }

    <section class="prose-content mt-10">
      <Content />
    </section>

    {
      vlog.data.tags.length > 0 && (
        <p class="mt-8 text-sm text-muted">Tags: {vlog.data.tags.join(", ")}</p>
      )
    }

    <div class="mt-8">
      <ShareButtons title={vlog.data.title} path={pagePath} />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="no-print mt-16">
        <h2 class="font-serif text-3xl">Related vlogs</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {related.map((item) => (
            <VlogCard vlog={item} />
          ))}
        </div>
      </section>
    )
  }

  <div class="no-print mt-16">
    <SubscribeCTA compact />
  </div>
</ContentLayout>
