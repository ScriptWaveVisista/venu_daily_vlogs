---
import { siteConfig } from "../config/site";
import { localeOg, otherLocale, type Locale } from "../i18n";
import { resolveOgImage } from "../utils/seo";
import { getCanonicalUrl, localePath, stripLocale } from "../utils/urls";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: string;
  type?: "website" | "article";
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  image,
  type = "website",
  canonicalPath,
  noindex = false,
} = Astro.props;

const rest = stripLocale(canonicalPath ?? Astro.url.pathname);
const canonical = getCanonicalUrl(localePath(locale, rest));
const enUrl = getCanonicalUrl(localePath("en", rest));
const teUrl = getCanonicalUrl(localePath("te", rest));
const ogImage = resolveOgImage(image);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="te" href={teUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={localeOg[locale]} />
<meta property="og:locale:alternate" content={localeOg[otherLocale(locale)]} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="author" content={siteConfig.author} />
{
  siteConfig.searchConsoleVerification && (
    <meta
      name="google-site-verification"
      content={siteConfig.searchConsoleVerification}
    />
  )
}
