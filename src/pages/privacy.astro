---
import { siteConfig } from "../config/site";
import ContentLayout from "../layouts/ContentLayout.astro";
import { pageTitle } from "../utils/seo";
import { isConfiguredEmail } from "../utils/urls";
---

<ContentLayout
  title={pageTitle("Privacy")}
  description={`Privacy information for ${siteConfig.name}.`}
  canonicalPath="/privacy/"
>
  <article class="prose-content">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">Legal</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Privacy</h1>
    <p class="mt-4 rounded-2xl bg-cream-deep px-4 py-3 text-sm">
      This page is a starting template, not legal advice. Review it with a qualified
      person before relying on it.
    </p>
    <h2>What this website is</h2>
    <p>
      {siteConfig.name} is a static website. It does not create user accounts, does
      not store comments, and does not process payments.
    </p>
    <h2>Analytics</h2>
    <p>
      If Google Analytics is enabled in <code>src/config/site.ts</code>, Google may
      collect standard usage information such as pages viewed and approximate
      location. If the Analytics ID is empty, Analytics is not loaded.
    </p>
    <h2>YouTube embeds</h2>
    <p>
      Some pages may embed YouTube videos using privacy-enhanced YouTube URLs.
      YouTube may set cookies or collect data according to Google’s policies when
      a visitor plays a video.
    </p>
    <h2>External links</h2>
    <p>
      Links to YouTube, Instagram, WhatsApp, Facebook or other websites are
      controlled by those services. Their privacy policies apply once you leave
      this site.
    </p>
    <h2>Cookies</h2>
    <p>
      This website itself does not set advertising cookies. Third-party embeds or
      Analytics, if enabled, may use cookies. You can control cookies in your
      browser settings.
    </p>
    <h2>Contact</h2>
    <p>
      {
        isConfiguredEmail(siteConfig.email) ? (
          <>
            For privacy questions, email{" "}
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
          </>
        ) : (
          <>
            Add a contact email in <code>src/config/site.ts</code> if you want a
            public privacy contact address.
          </>
        )
      }
    </p>
  </article>
</ContentLayout>
