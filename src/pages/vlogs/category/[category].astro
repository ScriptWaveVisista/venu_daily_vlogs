---
import EmptyState from "../../../components/EmptyState.astro";
import VlogCard from "../../../components/VlogCard.astro";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import {
  getPublishedVlogs,
  getVlogCategories,
  vlogsInCategory,
} from "../../../utils/content";
import { pageTitle } from "../../../utils/seo";
import { displayNameFromSlug, toSlug } from "../../../utils/slug";
import { withBase } from "../../../utils/urls";

export async function getStaticPaths() {
  const vlogs = await getPublishedVlogs();
  const categories = getVlogCategories(vlogs);

  return categories.map((category) => ({
    params: { category: toSlug(category) },
    props: { categoryName: category },
  }));
}

interface Props {
  categoryName: string;
}

const { categoryName } = Astro.props;
const slug = Astro.params.category ?? toSlug(categoryName);
const vlogs = vlogsInCategory(await getPublishedVlogs(), slug);
const label = displayNameFromSlug(slug, [categoryName]);
---

<ContentLayout
  title={pageTitle(`${label} Vlogs`)}
  description={`${label} vlogs and everyday videos from Venu Daily Vlogs.`}
  canonicalPath={`/vlogs/category/${slug}/`}
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">
      <a href={withBase("/vlogs/")} class="hover:underline">Vlogs</a>
    </p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">{label}</h1>
  </header>

  {
    vlogs.length > 0 ? (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {vlogs.map((vlog) => (
          <VlogCard vlog={vlog} />
        ))}
      </div>
    ) : (
      <div class="mt-10">
        <EmptyState
          title="No vlogs in this category yet"
          message="New videos will appear here."
        />
      </div>
    )
  }
</ContentLayout>
