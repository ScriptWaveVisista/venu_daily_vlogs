---
import CategoryFilter from "../../components/CategoryFilter.astro";
import EmptyState from "../../components/EmptyState.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import SearchBar from "../../components/SearchBar.astro";
import { siteConfig } from "../../config/site";
import ContentLayout from "../../layouts/ContentLayout.astro";
import {
  getPublishedRecipes,
  getRecipeCategories,
  recipeSearchText,
} from "../../utils/content";
import { pageTitle } from "../../utils/seo";

const recipes = await getPublishedRecipes();
const categories = getRecipeCategories(recipes);
---

<ContentLayout
  title={pageTitle("Recipes")}
  description="Simple homemade recipes with easy-to-follow ingredients, instructions and video guides."
  canonicalPath="/recipes/"
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">
      {siteConfig.shortName}
    </p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Recipes</h1>
    <p class="mt-4 text-lg text-muted">
      Simple homemade recipes with easy-to-follow ingredients, instructions and video guides.
    </p>
  </header>

  {
    recipes.length > 0 ? (
      <div class="mt-10 space-y-6">
        <SearchBar placeholder="Search recipes, ingredients or tags" />
        <CategoryFilter categories={categories} />
        <div id="recipe-grid" class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {recipes.map((recipe) => (
            <RecipeCard recipe={recipe} searchText={recipeSearchText(recipe)} />
          ))}
        </div>
        <p id="recipe-empty" class="hidden rounded-3xl border border-dashed border-line bg-white px-6 py-12 text-center text-muted">
          No recipes found. Try another search or category.
        </p>
      </div>
    ) : (
      <div class="mt-10">
        <EmptyState
          title="No recipes published yet"
          message="New recipes are coming soon."
        />
      </div>
    )
  }
</ContentLayout>

<script>
  const search = document.getElementById("recipe-search");
  const chips = document.querySelectorAll<HTMLButtonElement>(".category-chip");
  const cards = document.querySelectorAll<HTMLElement>(".recipe-card");
  const empty = document.getElementById("recipe-empty");
  let activeCategory = "all";

  function applyFilters() {
    const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
    let visible = 0;

    cards.forEach((card) => {
      const haystack = card.dataset.search ?? "";
      const category = card.dataset.category ?? "";
      const matchesQuery = !query || haystack.includes(query);
      const matchesCategory = activeCategory === "all" || category === activeCategory;
      const show = matchesQuery && matchesCategory;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    });

    empty?.classList.toggle("hidden", visible > 0);
  }

  search?.addEventListener("input", applyFilters);

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activeCategory = chip.dataset.category ?? "all";
      chips.forEach((item) => {
        const selected = item === chip;
        item.setAttribute("aria-pressed", String(selected));
        item.classList.toggle("bg-ink", selected);
        item.classList.toggle("text-white", selected);
        item.classList.toggle("border-ink", selected);
        item.classList.toggle("bg-white", !selected);
        item.classList.toggle("text-ink", !selected);
      });
      applyFilters();
    });
  });
</script>
