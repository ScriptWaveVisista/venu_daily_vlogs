---
import { localePath } from "../utils/urls";

const en = localePath("en", "/");
const te = localePath("te", "/");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Venu Daily Vlogs</title>
    <link rel="canonical" href={new URL(en, Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(en, Astro.site).toString()} />
    <link rel="alternate" hreflang="te" href={new URL(te, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(en, Astro.site).toString()} />
    <meta http-equiv="refresh" content={`0;url=${en}`} />
  </head>
  <body>
    <p>
      <a href={en}>English</a>
      ·
      <a href={te}>తెలుగు</a>
    </p>
    <script is:inline define:vars={{ en, te }}>
      const preferred = localStorage.getItem("preferredLanguage");
      location.replace(preferred === "te" ? te : en);
    </script>
  </body>
</html>
