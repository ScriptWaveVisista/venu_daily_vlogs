---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import SmartImage from "../../components/SmartImage.astro";
import SubscribeCTA from "../../components/SubscribeCTA.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import { siteConfig } from "../../config/site";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { getPublishedRecipes, type RecipeEntry } from "../../utils/content";
import { formatDate } from "../../utils/dates";
import { getRelatedItems } from "../../utils/related";
import { breadcrumbJsonLd, recipeJsonLd } from "../../utils/schema";
import { recipeTitle } from "../../utils/seo";
import { toSlug } from "../../utils/slug";
import { render } from "astro:content";

export async function getStaticPaths() {
  const recipes = await getPublishedRecipes();
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

interface Props {
  recipe: RecipeEntry;
}

const { recipe } = Astro.props;
const recipes = await getPublishedRecipes();
const related = getRelatedItems(recipe, recipes, 3);
const { Content } = await render(recipe);
const categorySlug = toSlug(recipe.data.category);
const pagePath = `/recipes/${recipe.id}/`;
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/recipes/", label: "Recipes" },
  { href: `/recipes/category/${categorySlug}/`, label: recipe.data.category },
  { href: pagePath, label: recipe.data.title },
];

const facts = [
  { label: "Prep Time", value: recipe.data.prepTime },
  { label: "Cook Time", value: recipe.data.cookTime },
  { label: "Total Time", value: recipe.data.totalTime },
  { label: "Servings", value: recipe.data.servings ? String(recipe.data.servings) : undefined },
  { label: "Difficulty", value: recipe.data.difficulty },
  { label: "Cuisine", value: recipe.data.cuisine },
].filter((fact) => fact.value);
---

<ContentLayout
  title={recipeTitle(recipe.data.title, recipe.data.teluguTitle)}
  description={recipe.data.description}
  image={recipe.data.thumbnail}
  canonicalPath={pagePath}
>
  <JsonLd schema={[recipeJsonLd(recipe), breadcrumbJsonLd(crumbs)]} />

  <article class="recipe-print">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-3xl">
      {recipe.data.demo && (
        <p class="mb-3 inline-flex rounded-full bg-cream-deep px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-ink">
          Demo sample recipe
        </p>
      )}
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">
        {recipe.data.category}
      </p>
      <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">{recipe.data.title}</h1>
      {
        recipe.data.teluguTitle && (
          <p class="mt-3 text-xl text-muted">{recipe.data.teluguTitle}</p>
        )
      }
      <p class="mt-4 text-lg text-muted">{recipe.data.description}</p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm text-muted">
        <span>By {siteConfig.author}</span>
        <time datetime={recipe.data.publishedDate.toISOString()}>
          {formatDate(recipe.data.publishedDate)}
        </time>
        {
          recipe.data.updatedDate && (
            <span>
              Updated {formatDate(recipe.data.updatedDate)}
            </span>
          )
        }
      </div>
    </header>

    <div class="mt-8 overflow-hidden rounded-[2rem]">
      <SmartImage
        src={recipe.data.thumbnail}
        alt={recipe.data.title}
        width={1600}
        height={1000}
        priority
        class="aspect-[16/10] w-full object-cover"
      />
    </div>

    {
      facts.length > 0 && (
        <dl class="mt-8 grid grid-cols-2 gap-4 rounded-3xl border border-line bg-white p-6 sm:grid-cols-3">
          {facts.map((fact) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">
                {fact.label}
              </dt>
              <dd class="mt-1 font-medium">{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      recipe.data.ingredients.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-serif text-3xl">Ingredients</h2>
          <ul class="mt-5 space-y-3">
            {recipe.data.ingredients.map((ingredient) => (
              <li>
                <label class="flex items-start gap-3 rounded-2xl bg-white px-4 py-3">
                  <input type="checkbox" class="mt-1 accent-orange-500" />
                  <span>
                    {ingredient.quantity && <strong>{ingredient.quantity}</strong>}
                    {ingredient.quantity ? " " : ""}
                    {ingredient.item}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recipe.data.instructions.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-serif text-3xl">Instructions</h2>
          <ol class="mt-5 space-y-4">
            {recipe.data.instructions.map((step, index) => (
              <li class="flex gap-4 rounded-2xl bg-white px-4 py-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-semibold text-white">
                  {index + 1}
                </span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      recipe.data.youtubeUrl && (
        <section class="no-print mt-12">
          <h2 class="font-serif text-3xl">Watch the video</h2>
          <div class="mt-5">
            <YouTubeEmbed youtubeUrl={recipe.data.youtubeUrl} title={recipe.data.title} />
          </div>
        </section>
      )
    }

    {
      recipe.data.tips.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-serif text-3xl">Tips</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5">
            {recipe.data.tips.map((tip) => (
              <li>{tip}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recipe.data.notes.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-serif text-3xl">Notes</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5">
            {recipe.data.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="prose-content mt-12">
      <Content />
    </section>

    {
      recipe.data.tags.length > 0 && (
        <p class="mt-8 text-sm text-muted">
          Tags: {recipe.data.tags.join(", ")}
        </p>
      )
    }

    <div class="mt-8">
      <ShareButtons title={recipe.data.title} path={pagePath} />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="no-print mt-16">
        <h2 class="font-serif text-3xl">Related recipes</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {related.map((item) => (
            <RecipeCard recipe={item} />
          ))}
        </div>
      </section>
    )
  }

  <div class="no-print mt-16">
    <SubscribeCTA compact />
  </div>
</ContentLayout>
