---
import { siteConfig } from "../config/site";
import { isConfiguredUrl } from "../utils/urls";

interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = "", compact = false } = Astro.props;

const links = [
  { href: siteConfig.youtube, label: "YouTube" },
  { href: siteConfig.instagram, label: "Instagram" },
  { href: siteConfig.facebook, label: "Facebook" },
].filter((link) => isConfiguredUrl(link.href));
---

{
  links.length > 0 && (
    <ul class:list={["flex flex-wrap items-center gap-3", className]}>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex items-center gap-1.5 text-sm font-medium text-ink underline-offset-4 hover:text-accent-deep hover:underline",
              compact && "text-xs",
            ]}
          >
            {link.label}
            <span aria-hidden="true" class="text-xs">↗</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
