---
import { siteConfig } from "../../config/site";
import { isLocale, localeStaticPaths, t } from "../../i18n";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { pageTitle } from "../../utils/seo";
import { isConfiguredEmail, localePath } from "../../utils/urls";

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang;
if (!isLocale(lang)) throw new Error("Invalid locale");
const locale = lang;
const copy = t(locale);
---

<ContentLayout
  title={pageTitle(copy.pages.privacyTitle)}
  description={copy.pages.privacyDescription}
  locale={locale}
  canonicalPath={localePath(locale, "/privacy/")}
>
  <article class="prose-content">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">{copy.pages.privacyLegal}</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">{copy.pages.privacyTitle}</h1>
    <p class="mt-4 rounded-2xl bg-cream-deep px-4 py-3 text-sm">{copy.pages.privacyDisclaimer}</p>
    <h2>{copy.pages.privacyWhatTitle}</h2>
    <p>{copy.pages.privacyWhat}</p>
    <h2>{copy.pages.privacyAnalyticsTitle}</h2>
    <p>{copy.pages.privacyAnalytics}</p>
    <h2>{copy.pages.privacyYoutubeTitle}</h2>
    <p>{copy.pages.privacyYoutube}</p>
    <h2>{copy.pages.privacyLinksTitle}</h2>
    <p>{copy.pages.privacyLinks}</p>
    <h2>{copy.pages.privacyCookiesTitle}</h2>
    <p>{copy.pages.privacyCookies}</p>
    <h2>{copy.pages.privacyContactTitle}</h2>
    <p>
      {
        isConfiguredEmail(siteConfig.email) ? (
          <>
            {copy.pages.email}:{" "}
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
          </>
        ) : (
          copy.pages.privacyContactEmpty
        )
      }
    </p>
  </article>
</ContentLayout>
