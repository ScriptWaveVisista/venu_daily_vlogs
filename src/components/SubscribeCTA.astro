---
import { siteConfig } from "../config/site";
import { t, type Locale } from "../i18n";
import { publicAssetExists } from "../utils/images";
import { isConfiguredUrl, withBase } from "../utils/urls";

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const copy = t(locale);
const youtubeReady = isConfiguredUrl(siteConfig.youtube);
const qrReady = publicAssetExists(siteConfig.youtubeQrImage);
---

<section
  class:list={[
    "no-print overflow-hidden rounded-[1.75rem] bg-ink text-white",
    compact ? "px-6 py-8" : "px-6 py-10 sm:px-10 sm:py-12",
  ]}
>
  <div class="mx-auto flex max-w-4xl flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{copy.home.ctaEyebrow}</p>
      <h2 class="mt-3 font-serif text-3xl leading-tight sm:text-4xl">
        {copy.home.ctaTitle}
      </h2>
      <p class="mt-3 text-white/80">
        {copy.home.ctaBody}
      </p>
    </div>
    <div class="flex flex-col items-start gap-4 sm:items-end">
      {
        youtubeReady ? (
          <a
            href={siteConfig.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-deep"
          >
            ▶ {copy.common.subscribe}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          <p class="rounded-full border border-white/20 px-4 py-2 text-sm text-white/70">
            {copy.pages.addYoutube}
          </p>
        )
      }
      {
        qrReady && (
          <img
            src={withBase(siteConfig.youtubeQrImage)}
            alt={`QR code to subscribe to ${siteConfig.name} on YouTube`}
            width="120"
            height="120"
            class="rounded-xl bg-white p-2"
            loading="lazy"
          />
        )
      }
    </div>
  </div>
</section>
