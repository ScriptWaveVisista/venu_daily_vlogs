---
import { recipeCategoryLabel, t, type Locale } from "../i18n";
import type { RecipeEntry } from "../utils/content";
import { recipeAltTitle, recipeDescription, recipeTitle } from "../utils/content";
import { localePath } from "../utils/urls";
import { toSlug } from "../utils/slug";
import SmartImage from "./SmartImage.astro";

interface Props {
  recipe: RecipeEntry;
  locale: Locale;
  searchText?: string;
}

const { recipe, locale, searchText } = Astro.props;
const copy = t(locale);
const title = recipeTitle(recipe, locale);
const altTitle = recipeAltTitle(recipe, locale);
const description = recipeDescription(recipe, locale);
const time = recipe.data.totalTime || recipe.data.cookTime || recipe.data.prepTime;
---

<article
  class="recipe-card group overflow-hidden rounded-3xl border border-line/80 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
  data-search={searchText}
  data-category={toSlug(recipe.data.category)}
>
  <a href={localePath(locale, `/recipes/${recipe.id}/`)} class="block">
    <div class="overflow-hidden">
      <SmartImage
        src={recipe.data.thumbnail}
        alt={title}
        width={900}
        height={675}
        class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
      />
    </div>
    <div class="space-y-2.5 p-5">
      <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-accent-deep">
        <span>{recipeCategoryLabel(recipe.data.category, locale)}</span>
        {recipe.data.demo && (
          <span class="rounded-full bg-cream-deep px-2 py-0.5 text-[10px] text-ink">{copy.common.demo}</span>
        )}
        {recipe.data.draft && (
          <span class="rounded-full bg-ink px-2 py-0.5 text-[10px] text-white">Draft</span>
        )}
      </div>
      <h3 class="font-serif text-2xl leading-tight">{title}</h3>
      {altTitle && <p class="text-sm text-muted">{altTitle}</p>}
      <p class="line-clamp-2 text-sm text-muted">{description}</p>
      <div class="flex flex-wrap items-center justify-between gap-3 pt-1 text-xs text-muted">
        {time && <span>⏱ {time}</span>}
        <span class="font-semibold text-accent-deep">{copy.common.viewRecipe} →</span>
      </div>
    </div>
  </a>
</article>
