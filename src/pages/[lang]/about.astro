---
import { siteConfig } from "../../config/site";
import { isLocale, localeStaticPaths, t } from "../../i18n";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { publicAssetExists } from "../../utils/images";
import { pageTitle } from "../../utils/seo";
import { isConfiguredUrl, localePath, withBase } from "../../utils/urls";

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang;
if (!isLocale(lang)) throw new Error("Invalid locale");
const locale = lang;
const copy = t(locale);
const hasProfile = publicAssetExists(siteConfig.profileImage);
---

<ContentLayout
  title={pageTitle(copy.pages.aboutTitle)}
  description={copy.pages.aboutDescription}
  locale={locale}
  canonicalPath={localePath(locale, "/about/")}
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">{copy.pages.aboutEyebrow}</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">{copy.pages.aboutTitle}</h1>
  </header>

  <div class="mt-10 grid gap-10 lg:grid-cols-[280px_1fr]">
    <div>
      {
        hasProfile ? (
          <img
            src={withBase(siteConfig.profileImage)}
            alt={`${siteConfig.author} of ${siteConfig.name}`}
            width="560"
            height="700"
            class="w-full rounded-[1.75rem] object-cover"
          />
        ) : (
          <div class="flex aspect-[4/5] items-end rounded-[1.75rem] bg-cream-deep p-8">
            <div>
              <p class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-2xl font-bold text-white">
                V
              </p>
              <p class="mt-4 font-serif text-xl">{siteConfig.name}</p>
            </div>
          </div>
        )
      }
    </div>

    <div class="max-w-2xl space-y-6 text-lg leading-relaxed">
      <p>{copy.pages.aboutP1}</p>
      <p>{copy.pages.aboutP2}</p>
      <div class="rounded-3xl border border-dashed border-line bg-white p-6 text-base">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-muted">
          {copy.pages.aboutNoteTitle}
        </p>
        <p class="mt-3 text-muted">{copy.pages.aboutNote}</p>
      </div>
      <ul class="grid gap-3 text-base sm:grid-cols-2">
        <li class="rounded-2xl bg-white px-4 py-3">{copy.pages.cookingVideos}</li>
        <li class="rounded-2xl bg-white px-4 py-3">{copy.pages.everydayLifestyle}</li>
        <li class="rounded-2xl bg-white px-4 py-3">{copy.pages.foodAndRecipes}</li>
        <li class="rounded-2xl bg-white px-4 py-3">{copy.pages.familyMoments}</li>
        <li class="rounded-2xl bg-white px-4 py-3">{copy.pages.travelVlogs}</li>
        <li class="rounded-2xl bg-white px-4 py-3">{copy.pages.teluguContent}</li>
      </ul>
      <div class="flex flex-wrap gap-3">
        {
          isConfiguredUrl(siteConfig.youtube) && (
            <a
              href={siteConfig.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white hover:bg-accent-deep"
            >
              YouTube
            </a>
          )
        }
        {
          isConfiguredUrl(siteConfig.instagram) && (
            <a
              href={siteConfig.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-line bg-white px-5 py-3 text-sm font-semibold hover:border-accent"
            >
              Instagram
            </a>
          )
        }
      </div>
    </div>
  </div>
</ContentLayout>
