---
import EmptyState from "../../../../components/EmptyState.astro";
import VlogCard from "../../../../components/VlogCard.astro";
import { locales, t, vlogCategoryLabel, type Locale } from "../../../../i18n";
import ContentLayout from "../../../../layouts/ContentLayout.astro";
import {
  getPublishedVlogs,
  getVlogCategories,
  vlogsInCategory,
} from "../../../../utils/content";
import { pageTitle } from "../../../../utils/seo";
import { localePath } from "../../../../utils/urls";

export async function getStaticPaths() {
  const vlogs = await getPublishedVlogs();
  const categories = getVlogCategories(vlogs);

  return locales.flatMap((lang) =>
    categories.map((category) => ({
      params: { lang, category },
      props: { locale: lang, category },
    })),
  );
}

interface Props {
  locale: Locale;
  category: string;
}

const { locale, category } = Astro.props;
const copy = t(locale);
const vlogs = vlogsInCategory(await getPublishedVlogs(), category);
const label = vlogCategoryLabel(category, locale);
---

<ContentLayout
  title={pageTitle(label)}
  description={`${label} — ${copy.pages.vlogsDescription}`}
  locale={locale}
  canonicalPath={localePath(locale, `/vlogs/category/${category}/`)}
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">
      <a href={localePath(locale, "/vlogs/")} class="hover:underline">{copy.nav.vlogs}</a>
    </p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">{label}</h1>
  </header>

  {
    vlogs.length > 0 ? (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {vlogs.map((vlog) => (
          <VlogCard vlog={vlog} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="mt-10">
        <EmptyState title={copy.common.noVlogs} message={copy.common.noVlogsMessage} />
      </div>
    )
  }
</ContentLayout>
