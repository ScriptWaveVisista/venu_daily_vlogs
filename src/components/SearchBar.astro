---
interface Props {
  placeholder?: string;
}

const { placeholder = "Search recipes" } = Astro.props;
---

<label class="block">
  <span class="sr-only">{placeholder}</span>
  <input
    id="recipe-search"
    type="search"
    placeholder={placeholder}
    class="w-full rounded-full border border-line bg-white px-5 py-3 text-base outline-none ring-accent focus:ring-2"
  />
</label>
