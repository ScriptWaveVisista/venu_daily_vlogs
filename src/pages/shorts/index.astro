---
import EmptyState from "../../components/EmptyState.astro";
import ShortCard from "../../components/ShortCard.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { getPublishedShorts } from "../../utils/content";
import { pageTitle } from "../../utils/seo";

const shorts = await getPublishedShorts();
---

<ContentLayout
  title={pageTitle("Shorts")}
  description="Quick cooking, food and lifestyle YouTube Shorts from Venu Daily Vlogs."
  canonicalPath="/shorts/"
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">Quick watch</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Shorts</h1>
    <p class="mt-4 text-lg text-muted">
      Short cooking clips and everyday moments. Thumbnails link out to YouTube so this page stays fast.
    </p>
  </header>

  {
    shorts.length > 0 ? (
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
        {shorts.map((short) => (
          <ShortCard short={short} />
        ))}
      </div>
    ) : (
      <div class="mt-10">
        <EmptyState
          title="No Shorts published yet"
          message="Short cooking and lifestyle clips will appear here."
        />
      </div>
    )
  }
</ContentLayout>
