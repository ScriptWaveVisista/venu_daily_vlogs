---
import CategoryFilter from "../../../components/CategoryFilter.astro";
import EmptyState from "../../../components/EmptyState.astro";
import RecipeCard from "../../../components/RecipeCard.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { isLocale, localeStaticPaths, t } from "../../../i18n";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import {
  getPublishedRecipes,
  getRecipeCategories,
  recipeSearchText,
} from "../../../utils/content";
import { pageTitle } from "../../../utils/seo";
import { localePath } from "../../../utils/urls";

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang;
if (!isLocale(lang)) throw new Error("Invalid locale");
const locale = lang;
const copy = t(locale);
const recipes = await getPublishedRecipes();
const categories = getRecipeCategories(recipes);
---

<ContentLayout
  title={pageTitle(copy.pages.recipesTitle)}
  description={copy.pages.recipesDescription}
  locale={locale}
  canonicalPath={localePath(locale, "/recipes/")}
>
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-deep">
      {copy.common.cooking}
    </p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">{copy.pages.recipesTitle}</h1>
    <p class="mt-4 text-lg text-muted">{copy.pages.recipesDescription}</p>
  </header>

  {
    recipes.length > 0 ? (
      <div class="mt-10 space-y-6">
        <SearchBar placeholder={copy.common.searchRecipes} />
        <CategoryFilter categories={categories} locale={locale} />
        <div id="recipe-grid" class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {recipes.map((recipe) => (
            <RecipeCard recipe={recipe} locale={locale} searchText={recipeSearchText(recipe)} />
          ))}
        </div>
        <p id="recipe-empty" class="hidden rounded-3xl border border-dashed border-line bg-white px-6 py-12 text-center text-muted">
          {copy.common.noRecipesFound}
        </p>
      </div>
    ) : (
      <div class="mt-10">
        <EmptyState title={copy.common.noRecipes} message={copy.common.noRecipesMessage} />
      </div>
    )
  }
</ContentLayout>

<script>
  const search = document.getElementById("recipe-search");
  const chips = document.querySelectorAll<HTMLButtonElement>(".category-chip");
  const cards = document.querySelectorAll<HTMLElement>(".recipe-card");
  const empty = document.getElementById("recipe-empty");
  let activeCategory = "all";

  function applyFilters() {
    const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
    let visible = 0;

    cards.forEach((card) => {
      const haystack = card.dataset.search ?? "";
      const category = card.dataset.category ?? "";
      const matchesQuery = !query || haystack.includes(query);
      const matchesCategory = activeCategory === "all" || category === activeCategory;
      const show = matchesQuery && matchesCategory;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    });

    empty?.classList.toggle("hidden", visible > 0);
  }

  search?.addEventListener("input", applyFilters);

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activeCategory = chip.dataset.category ?? "all";
      chips.forEach((item) => {
        const selected = item === chip;
        item.setAttribute("aria-pressed", String(selected));
        item.classList.toggle("bg-ink", selected);
        item.classList.toggle("text-white", selected);
        item.classList.toggle("border-ink", selected);
        item.classList.toggle("bg-white", !selected);
        item.classList.toggle("text-ink", !selected);
      });
      applyFilters();
    });
  });
</script>
