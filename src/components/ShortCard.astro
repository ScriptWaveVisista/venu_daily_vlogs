---
import { t, type Locale } from "../i18n";
import type { ShortEntry } from "../utils/content";
import { shortTitle } from "../utils/content";
import { localePath } from "../utils/urls";
import SmartImage from "./SmartImage.astro";

interface Props {
  short: ShortEntry;
  locale: Locale;
}

const { short, locale } = Astro.props;
const copy = t(locale);
const title = shortTitle(short, locale);
const href = short.data.youtubeUrl || localePath(locale, "/shorts/");
const isExternal = Boolean(short.data.youtubeUrl);
---

<article class="group overflow-hidden rounded-3xl border border-line/80 bg-white shadow-sm">
  <a
    href={href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class="block"
  >
    <div class="relative overflow-hidden bg-ink">
      <SmartImage
        src={short.data.thumbnail}
        alt={title}
        width={720}
        height={1280}
        class="aspect-[9/16] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
      />
      <span class="absolute inset-0 flex items-center justify-center">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent text-white shadow-lg">
          ▶
        </span>
      </span>
    </div>
    <div class="space-y-1.5 p-3">
      <h3 class="font-serif text-lg leading-tight">{title}</h3>
      {isExternal && (
        <p class="text-xs font-semibold text-accent-deep">{copy.common.watchOnYoutube}</p>
      )}
    </div>
  </a>
</article>
