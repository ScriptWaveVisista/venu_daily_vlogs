---
import { siteConfig } from "../config/site";
import { publicAssetExists } from "../utils/images";
import { isConfiguredUrl } from "../utils/urls";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const youtubeReady = isConfiguredUrl(siteConfig.youtube);
const qrReady = publicAssetExists(siteConfig.youtubeQrImage);
---

<section
  class:list={[
    "no-print rounded-3xl bg-ink text-white",
    compact ? "px-6 py-8" : "px-6 py-12 sm:px-10",
  ]}
>
  <div class="mx-auto flex max-w-4xl flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">YouTube</p>
      <h2 class="mt-3 font-serif text-3xl leading-tight sm:text-4xl">
        Enjoying the videos?
      </h2>
      <p class="mt-3 text-white/80">
        Join {siteConfig.name} on YouTube for new recipes, family moments and lifestyle videos.
      </p>
    </div>
    <div class="flex flex-col items-start gap-4 sm:items-end">
      {
        youtubeReady ? (
          <a
            href={siteConfig.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-deep"
          >
            Subscribe on YouTube
            <span aria-hidden="true">↗</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          <p class="rounded-full border border-white/20 px-4 py-2 text-sm text-white/70">
            Add your YouTube URL in <code>src/config/site.ts</code>
          </p>
        )
      }
      {
        qrReady && (
          <img
            src={siteConfig.youtubeQrImage}
            alt={`QR code to subscribe to ${siteConfig.name} on YouTube`}
            width="120"
            height="120"
            class="rounded-xl bg-white p-2"
            loading="lazy"
          />
        )
      }
    </div>
  </div>
</section>
