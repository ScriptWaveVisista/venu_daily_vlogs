---
import { siteConfig } from "../config/site";
import { t, type Locale } from "../i18n";
import { isConfiguredUrl } from "../utils/urls";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const youtubeReady = isConfiguredUrl(siteConfig.youtube);
---

{
  youtubeReady && (
    <a
      href={siteConfig.youtube}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-subscribe no-print fixed bottom-4 right-4 z-40 inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-4 py-2.5 text-sm font-semibold text-white shadow-lg lg:hidden"
    >
      ▶ {copy.common.subscribe}
    </a>
  )
}
